# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Planilha de controle (relativo à raiz do projeto, ou caminho completo)
AUTOMACAO_ARQUIVO=data/base_demo.xlsx

# SIMULAR (só mostra) | RASCUNHO (salva no Outlook) | ENVIAR (envia)
AUTOMACAO_MODO=SIMULAR

# Se preenchido, TODOS os e-mails vão para este endereço (use na demo!)
AUTOMACAO_EMAIL_TESTE=

# Quem recebe os casos escalados (analista humano)
AUTOMACAO_EMAIL_HUMANO=

# Conta do Outlook que envia (ex.: caixa compartilhada). Vazio = conta padrão
AUTOMACAO_CONTA_REMETENTE=

# Dias de espera entre tentativas e máximo de envios automáticos antes de escalar
AUTOMACAO_REENVIO_DIAS=10
AUTOMACAO_MAX_ENVIOS=2

# Só use 1 em produção, com aprovação: permite ENVIAR para os contatos reais
AUTOMACAO_ENVIO_REAL=0
